      },
      {
        "accountId": "0", "containerId": "0", "tagId": "4",
        "name": "Google Ads Conversion - lead", "type": "awct",
        "paused": true,
        "parameter": [
          {"type": "TEMPLATE", "key": "conversionId", "value": "{{Constant - Google Ads Conversion ID}}"},
          {"type": "TEMPLATE", "key": "conversionLabel", "value": "{{Constant - Google Ads Conversion Label}}"},
          {"type": "TEMPLATE", "key": "orderId", "value": "{{DLV - event_id}}"}
        ],
        "firingTriggerId": ["3"]
      },
      {
        "accountId": "0", "containerId": "0", "tagId": "5",
        "name": "Meta Pixel - base", "type": "html",
        "paused": true,
        "parameter": [
          {"type": "TEMPLATE", "key": "html", "value": "<script>\n(function () {\n  var pixelId = '{{Constant - Meta Pixel ID}}';\n  if (!pixelId || pixelId === 'PIXEL_ID') return;\n  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n  n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n  n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n  t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script',\n  'https://connect.facebook.net/en_US/fbevents.js');\n  var ud = {};\n  var em = '{{DLV - email_hash}}';\n  var ph = '{{DLV - phone_hash}}';\n  var fbc = '{{DLV - fbc}}';\n  var fbp = '{{DLV - fbp}}';\n  var ext = '{{DLV - anon_id}}';\n  if (em) ud.em = em;\n  if (ph) ud.ph = ph;\n  if (fbc) ud.fbc = fbc;\n  if (fbp) ud.fbp = fbp;\n  if (ext) ud.external_id = ext;\n  fbq('init', pixelId, ud);\n  fbq('track', 'PageView', {}, {eventID: '{{DLV - event_id}}'});\n})();\n</script>"},
          {"type": "BOOLEAN", "key": "supportDocumentWrite", "value": "false"}
        ],
        "firingTriggerId": ["2"]
      },
      {
        "accountId": "0", "containerId": "0", "tagId": "6",
        "name": "Meta Pixel - Lead", "type": "html",
        "paused": true,
        "parameter": [
          {"type": "TEMPLATE", "key": "html", "value": "<script>\nif (window.fbq) {\n  var pixelId = '{{Constant - Meta Pixel ID}}';\n  var ud = {};\n  var em = '{{DLV - email_hash}}';\n  var ph = '{{DLV - phone_hash}}';\n  var fbc = '{{DLV - fbc}}';\n  var fbp = '{{DLV - fbp}}';\n  var ext = '{{DLV - anon_id}}';\n  if (em) ud.em = em;\n  if (ph) ud.ph = ph;\n  if (fbc) ud.fbc = fbc;\n  if (fbp) ud.fbp = fbp;\n  if (ext) ud.external_id = ext;\n  if (pixelId && pixelId !== 'PIXEL_ID') fbq('init', pixelId, ud);\n  fbq('track', 'Lead', {}, {eventID: '{{DLV - event_id}}'});\n}\n</script>"},
          {"type": "BOOLEAN", "key": "supportDocumentWrite", "value": "false"}
        ],
        "firingTriggerId": ["3"]
