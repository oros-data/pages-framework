          {"type": "TEMPLATE", "key": "measurementId", "value": "{{Constant - GA4 Measurement ID}}"}
        ],
        "firingTriggerId": ["1"]
      },
      {
        "accountId": "0", "containerId": "0", "tagId": "2",
        "name": "GA4 Event", "type": "gaawe",
        "parameter": [
          {"type": "TEMPLATE", "key": "eventName", "value": "{{Event}}"},
          {"type": "LIST", "key": "eventParameters", "list": [
            {"type": "MAP", "map": [
              {"type": "TEMPLATE", "key": "name", "value": "anon_id"},
              {"type": "TEMPLATE", "key": "value", "value": "{{DLV - anon_id}}"}
            ]},
            {"type": "MAP", "map": [
              {"type": "TEMPLATE", "key": "name", "value": "gclid"},
              {"type": "TEMPLATE", "key": "value", "value": "{{DLV - gclid}}"}
            ]},
