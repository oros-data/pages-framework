{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pages-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "pages-site-staging",
      "main": "worker.js",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
